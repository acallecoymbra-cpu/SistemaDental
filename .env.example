# Copiar a .env y ajustar. Valores solo para desarrollo local; nunca usar en producción.
NODE_ENV=development
PORT=3001

# PostgreSQL local (docker compose)
POSTGRES_USER=dental
POSTGRES_PASSWORD=dental_dev
POSTGRES_DB=sistema_dental
POSTGRES_PORT=5432
DATABASE_URL=postgres://dental:dental_dev@localhost:5432/sistema_dental

# Base usada por las pruebas de integración (pnpm test:integration)
DATABASE_URL_TEST=postgres://dental:dental_dev@localhost:5432/sistema_dental_test
