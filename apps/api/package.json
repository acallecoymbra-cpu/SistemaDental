{
  "name": "@sistema-dental/api",
  "version": "0.0.0",
  "private": true,
  "description": "API NestJS del sistema dental",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:integration": "jest -c jest.integration.config.js --runInBand",
    "migration:run": "node --env-file-if-exists=../../.env ./node_modules/typeorm/cli.js -d dist/database/data-source.js migration:run",
    "migration:revert": "node --env-file-if-exists=../../.env ./node_modules/typeorm/cli.js -d dist/database/data-source.js migration:revert",
    "migration:show": "node --env-file-if-exists=../../.env ./node_modules/typeorm/cli.js -d dist/database/data-source.js migration:show",
    "migration:create": "node ./node_modules/typeorm/cli.js migration:create",
    "dentist:create": "node --env-file-if-exists=../../.env dist/cli/create-dentist.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/typeorm": "11.0.3",
    "@node-rs/argon2": "2.2.2",
    "@sistema-dental/contracts": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "joi": "18.3.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.11",
    "@sistema-dental/config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
